\contentsline {subsection}{\numberline {6.3}Propriétés de sûreté}{7}{subsection.6.3}%
\contentsline {paragraph}{S1 -- la piste ne peut pas être dans deux états à la fois.}{7}{subsection.6.3}%
\contentsline {paragraph}{S2 -- une autorisation implique une réservation préalable.}{7}{subsection.6.3}%
\contentsline {paragraph}{S3 -- un atterrissage en cours implique une piste occupée.}{7}{subsection.6.3}%
\contentsline {subsection}{\numberline {6.4}Propriétés de vivacité}{7}{subsection.6.4}%
\contentsline {paragraph}{V1 -- toute occupation de piste finit par se terminer.}{7}{subsection.6.4}%
\contentsline {paragraph}{V2 -- tout scénario nominal finit par atteindre un état terminal correct.}{7}{subsection.6.4}%
\contentsline {paragraph}{V3 -- toute demande reçoit finalement une réponse.}{7}{subsection.6.4}%
\contentsline {paragraph}{V4 -- tout avion autorisé finit par atteindre le sol.}{8}{subsection.6.4}%
